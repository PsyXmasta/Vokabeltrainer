<Window x:Class="Vokabeltrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vokabeltrainer"
        Height="500"
        Width="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Label Content="Deutsch"/>
            <TextBox x:Name="txtDeutsch"/>

            <Label Content="Englisch"/>
            <TextBox x:Name="txtEnglisch"/>

            <Label Content="Kategorie"/>
            <TextBox x:Name="txtKategorie"/>

        </StackPanel>

        <Button Grid.Row="1"
                Content="Hinzufügen"
                Width="120"
                Height="30"
                Margin="0,10,0,10"
                Click="BtnHinzufuegen_Click"/>

        <DataGrid x:Name="dgVokabeln"
                  Grid.Row="2"
                  AutoGenerateColumns="True"/>

        <StackPanel Grid.Row="3"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">

            <Button Content="Speichern"
                    Width="120"
                    Margin="5"
                    Click="BtnSpeichern_Click"/>

            <Button Content="Laden"
                    Width="120"
                    Margin="5"
                    Click="BtnLaden_Click"/>

        </StackPanel>

    </Grid>
</Window>