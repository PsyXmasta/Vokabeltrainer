<Window x:Class="Vokabeltrainer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vokabeltrainer"
        Height="500"
        Width="800">

    <Grid Margin="10">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">

            <Label Content="Deutsch"/>
            <TextBox x:Name="txtDeutsch"/>

            <Label Content="Englisch"/>
            <TextBox x:Name="txtEnglisch"/>

            <Label Content="Kategorie"/>
            <TextBox x:Name="txtKategorie"/>

        </StackPanel>

        <StackPanel Grid.Row="1"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,10">

            <Button Content="Hinzufügen"
            Width="120"
            Margin="5"
            Click="BtnHinzufuegen_Click"/>

            <Button Content="Bearbeiten"
            Width="120"
            Margin="5"
            Click="BtnBearbeiten_Click"/>

            <Button Content="Löschen"
            Width="120"
            Margin="5"
            Click="BtnLoeschen_Click"/>

        </StackPanel>


        <DataGrid x:Name="dgVokabeln"
                  Grid.Row="2"
                  AutoGenerateColumns="True"/>

        <Button Grid.Row="3"
        Content="Training starten"
        Height="35"
        Margin="0,10,0,10"
        Click="BtnTraining_Click"/>

        <StackPanel Grid.Row="4"
            Orientation="Horizontal"
            HorizontalAlignment="Center"
            Margin="0,10,0,0">

            <Button Content="Speichern"
            Width="120"
            Margin="5"
            Click="BtnSpeichern_Click"/>

            <Button Content="Laden"
            Width="120"
            Margin="5"
            Click="BtnLaden_Click"/>

        </StackPanel>

    </Grid>
</Window>